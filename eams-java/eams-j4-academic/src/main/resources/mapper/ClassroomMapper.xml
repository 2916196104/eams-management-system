<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zeroone.star.academic.mapper.ClassroomMapper">
    <select id="getList" resultType="com.zeroone.star.project.vo.j4.academic.ClassroomVO">
        select t1.*
        from classroom t1
        <where>
            <if test="query.name != null and query.name != ''">
                AND t1.name like concat('%', #{query.name}, '%')
            </if>
            AND t1.deleted != 1
        </where>
    </select>
</mapper>
