<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zeroone.star.stumanager.mapper.StudentMapper">

    <select id="getStudentDetailsById" resultType="com.zeroone.star.project.vo.j8.stumanager.StudentVO">
        select s.stage,s.sex,s.age,s.birthday,s.idcard,
               u.name,s.family_rel,s.grade_id,s.join_date,s.add_time
        from student s left join user u on s.user_id = u.id
        where s.id=#{id}
    </select>
</mapper>

