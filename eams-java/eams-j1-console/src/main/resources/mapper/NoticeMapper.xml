<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zeroone.star.j1.console.mapper.NoticeMapper">

    <!-- 公告分页查询 -->
    <select id="selectNoticePage" resultType="com.zeroone.star.project.dto.j1.console.ConsoleNoticeDTO">
        SELECT
            id,
            title,
            content,
            view_num as viewNum,
            creator,
            add_time as addTime
        FROM notice
        WHERE deleted = 0
        <if test="title != null and title != ''">
            AND title LIKE CONCAT('%', #{title}, '%')
        </if>
        ORDER BY add_time DESC
    </select>

</mapper>
