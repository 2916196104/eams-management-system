<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zeroone.star.education.mapper.ClassMapper">
    <select id="getByClassName" resultType="com.zeroone.star.project.vo.j5.schedule.ClassOptionVO">
        select
            c.id,
            c.name as className,
            co.name as courseName
        from class c
        left join course co on c.course_id = co.id
        <where>
            <if test="query.className != null and query.className != ''">
                and c.name like concat('%',#{query.className},'%')
            </if>
        </where>
    </select>
</mapper>