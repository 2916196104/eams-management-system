{
  "name": "@eams/vue-element-cui",
  "version": "1.0.0",
  "description": "EAMS Vue Element Component UI Library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/styles/index.css",
    "./styles/*": "./dist/styles/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && pnpm run build:styles",
    "build:js": "vite build",
    "build:styles": "sass src/styles/index.scss dist/styles/index.css --no-source-map",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "element-plus": "^2.8.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "element-plus": "^2.8.0",
    "jsdom": "^25.0.1",
    "sass": "^1.83.4",
    "tsdown": "^0.3.0",
    "typescript": "^5.9.3",
    "unplugin-vue": "^7.1.1",
    "vite": "^6.0.11",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^3.2.5"
  },
  "keywords": [
    "vue",
    "element-plus",
    "component",
    "ui",
    "eams"
  ],
  "license": "MIT"
}
